# python-mcp-demo 开发环境配置
# 用法: MCP_ENV=dev uv run python -m python_mcp_demo
MCP_ENV=dev

# ── 服务器 ──────────────────────────────────
MCP_SERVER_NAME=ai-office-mcp-dev
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── 后端 API ────────────────────────────────
MCP_BACKEND_BASE_URL=http://localhost:8080
MCP_BACKEND_AUTH_URL=http://localhost:8080/api/auth/verify

# ── 日志 ────────────────────────────────────
MCP_LOG_LEVEL=DEBUG
# false = 人类可读彩色日志，方便终端查看
MCP_LOG_JSON=false

# ── 超时 ────────────────────────────────────
MCP_REQUEST_TIMEOUT=20
MCP_CONNECT_TIMEOUT=5

# ── 重试 ────────────────────────────────────
MCP_MAX_RETRIES=3
MCP_RETRY_MIN_DELAY=1.0
MCP_RETRY_MAX_DELAY=8.0

# ── 安全 ────────────────────────────────────
MCP_TOKEN_MASK_PREFIX_LEN=8
