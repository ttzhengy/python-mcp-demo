# python-mcp-demo 生产环境配置
# 用法: MCP_ENV=prod uv run python -m python_mcp_demo
MCP_ENV=prod

# ── 服务器 ──────────────────────────────────
MCP_SERVER_NAME=ai-office-mcp
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── 后端 API ────────────────────────────────
MCP_BACKEND_BASE_URL=http://prod-backend:8080
MCP_BACKEND_AUTH_URL=http://prod-backend:8080/api/auth/verify

# ── 日志 ────────────────────────────────────
MCP_LOG_LEVEL=WARNING
# true = JSON 结构化日志，由容器运行时采集
MCP_LOG_JSON=true

# ── 超时 ────────────────────────────────────
MCP_REQUEST_TIMEOUT=30
MCP_CONNECT_TIMEOUT=10

# ── 重试 ────────────────────────────────────
MCP_MAX_RETRIES=3
MCP_RETRY_MIN_DELAY=1.0
MCP_RETRY_MAX_DELAY=8.0

# ── 安全 ────────────────────────────────────
MCP_TOKEN_MASK_PREFIX_LEN=8
