# python-mcp-demo 配置
#
# 多环境支持：通过 MCP_ENV 切换环境
#   MCP_ENV=dev  → 加载 .env.dev（开发环境，DEBUG 日志，localhost 后端）
#   MCP_ENV=test → 加载 .env.test（测试环境，JSON 日志，测试后端）
#   MCP_ENV=prod → 加载 .env.prod（生产环境，JSON 日志，生产后端）
#
# K8s 部署只需设置 MCP_ENV=prod，其余配置从 .env.prod 读取。
# 环境变量优先级最高：环境变量 > .env.* > 默认值

# ── 环境标识 ────────────────────────────────
# 切换环境文件（dev/test/prod），默认 dev
MCP_ENV=dev

# ── 服务器 ──────────────────────────────────
# FastMCP 服务器名称
MCP_SERVER_NAME=ai-office-mcp
# 监听地址（0.0.0.0 = 所有网络接口）
# MCP_HOST=0.0.0.0
# 监听端口
# MCP_PORT=8000

# ── 后端 API ────────────────────────────────
# Java 后端服务基础 URL
# MCP_BACKEND_BASE_URL=http://localhost:8080
# 认证服务 API URL（verify_token 前置校验）
# MCP_BACKEND_AUTH_URL=http://localhost:8080/api/auth/verify

# ── 日志 ────────────────────────────────────
# 日志级别：DEBUG | INFO | WARNING | ERROR
# MCP_LOG_LEVEL=INFO
# JSON 结构化日志（true=JSON, false=人类可读）
# MCP_LOG_JSON=true

# ── 超时 ────────────────────────────────────
# HTTP 读超时（秒）
# MCP_REQUEST_TIMEOUT=20
# HTTP 连接超时（秒）
# MCP_CONNECT_TIMEOUT=5

# ── 重试 ────────────────────────────────────
# 5xx 错误最大重试次数
# MCP_MAX_RETRIES=3
# 重试初始间隔（秒）
# MCP_RETRY_MIN_DELAY=1.0
# 重试最大间隔（秒）
# MCP_RETRY_MAX_DELAY=8.0

# ── 安全 ────────────────────────────────────
# Token 脱敏保留的前缀字符数
# MCP_TOKEN_MASK_PREFIX_LEN=8
