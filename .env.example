# python-mcp-demo configuration
# Copy this file to .env and adjust values as needed.
#
#   cp .env.example .env

# Name exposed by the MCP server
# MCP_SERVER_NAME=python-mcp-demo

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# MCP_LOG_LEVEL=INFO

# Default HTTP request timeout in seconds
# MCP_REQUEST_TIMEOUT=30

# Maximum bytes of content preview for fetch_url tool
# MCP_MAX_FETCH_SIZE=5000
